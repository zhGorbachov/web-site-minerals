# Production reverse proxy for lux-stones.com.ua.
# Caddy obtains Let's Encrypt certificates automatically (ports 80 + 443).

{
	email admin@lux-stones.com.ua
}

www.lux-stones.com.ua {
	redir https://lux-stones.com.ua{uri} permanent
}

lux-stones.com.ua {
	encode gzip

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /media/* {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
