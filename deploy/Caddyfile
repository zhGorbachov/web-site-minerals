# Production reverse proxy for lux-stones.com.ua.
# Caddy obtains Let's Encrypt certificates automatically (ports 80 + 443).

{
	email admin@lux-stones.com.ua
}

www.lux-stones.com.ua {
	redir https://lux-stones.com.ua{uri} permanent
}

lux-stones.com.ua {
	encode gzip

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /media/* {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv

		# Vite fingerprints everything in /assets, so browsers may keep it for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html and other unhashed files must be revalidated so a deploy shows up at once.
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
