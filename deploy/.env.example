# =============================================================================
# Production env for docker-compose.prod.yml (copy to repo root as `.env`)
#   cp deploy/.env.example .env
# =============================================================================

# Public origin (no trailing slash). Used for CORS and OAuth redirects.
CLIENT_URL=https://lux-stones.com.ua
API_URL=https://lux-stones.com.ua

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Postgres (internal Docker network only — not exposed publicly)
POSTGRES_USER=minerals
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=minerals

# Optional OAuth / delivery APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
NOVA_POSHTA_API_KEY=

# TurboSMS transactional SMS. Enable HTTP API in the TurboSMS account first.
TURBOSMS_TOKEN=
TURBOSMS_SENDER=lux_.stones
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Bootstrap admin (created/updated on every API start)
ADMIN_PHONE=0668344322
ADMIN_PASSWORD=hMJ5Pz&B6*%*Efez33
ADMIN_FIRST_NAME=Адмін
ADMIN_LAST_NAME=Глущенко
ADMIN_EMAIL=admin@luxstones.local

# -----------------------------------------------------------------------------
# Lightsail firewall — NOT read by the app
# Console → instance → Networking:
#
#   HTTP  80    0.0.0.0/0     (Let's Encrypt + redirect to HTTPS)
#   HTTPS 443   0.0.0.0/0
#   SSH   22    YOUR_IP/32
# -----------------------------------------------------------------------------
