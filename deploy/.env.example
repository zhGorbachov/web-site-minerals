# =============================================================================
# Production env for docker-compose.prod.yml (copy to repo root as `.env`)
#   cp deploy/.env.example .env
# =============================================================================

# Public origin of this Lightsail instance (Static IP or domain). No trailing slash.
# Used for CORS and OAuth redirects.
CLIENT_URL=http://YOUR_STATIC_IP
API_URL=http://YOUR_STATIC_IP

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Postgres (internal Docker network only — not exposed publicly)
POSTGRES_USER=minerals
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=minerals

# Optional OAuth / delivery APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
NOVA_POSHTA_API_KEY=

# TurboSMS transactional SMS. Enable HTTP API in the TurboSMS account first.
TURBOSMS_TOKEN=
TURBOSMS_SENDER=LuxStones
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Bootstrap admin (created/updated on every API start)
ADMIN_PHONE=0668344322
ADMIN_PASSWORD=hMJ5Pz&B6*%*Efez33
ADMIN_FIRST_NAME=Адмін
ADMIN_LAST_NAME=Глущенко
ADMIN_EMAIL=admin@luxstones.local

# -----------------------------------------------------------------------------
# ALLOWED_IPS (Lightsail firewall — NOT read by the app)
# Configure in Lightsail Console → instance → Networking.
# Remove default 0.0.0.0/0 for HTTP and SSH, then add only:
#
#   YOUR_IP_1/32
#   YOUR_IP_2/32
#
# Ports: HTTP 80, SSH 22.
# -----------------------------------------------------------------------------
