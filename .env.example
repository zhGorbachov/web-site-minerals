# Frontend
# Dev (Vite): leave unset or point at the API. Vite already proxies /api → :3001.
# VITE_API_URL=http://localhost:3001
#
# Production via Caddy (start.bat): use empty so the browser calls same-origin /api
# (see .env.production). Do not use build:mock if you want the real backend.
VITE_API_URL=

# Set to true (or use `npm run dev:mock` / `npm run build:mock`) to run without Docker/API/DB.
# VITE_MOCK=true

# See also server/.env.example for DATABASE_URL, JWT_SECRET, Google/Apple OAuth.

# Optional: for live checkout city/branch search via API server
# NOVA_POSHTA_API_KEY is configured on the server (see server/.env.example)
