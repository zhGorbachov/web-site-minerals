# Server
PORT=3001
# Comma-separated allowed origins (Vite :5174 and/or Caddy :3000)
CLIENT_URL=http://localhost:5174,http://localhost:3000
DATABASE_URL=postgresql://minerals:minerals@127.0.0.1:55432/minerals?schema=public
JWT_SECRET=dev-change-me-minerals-jwt-secret
JWT_EXPIRES_IN=7d
# Public API URL for OAuth redirects. With Caddy, use the site origin:
# API_URL=http://localhost:3000
API_URL=http://localhost:3001

# Google OAuth (Web client) — redirect URI must match API_URL:
# http://localhost:3001/api/auth/google/callback
# or http://localhost:3000/api/auth/google/callback when using Caddy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (Services ID) — return URL:
# http://localhost:3001/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Nova Poshta API key (https://new.novaposhta.ua/ → Settings → API). Optional: without it cities/warehouses use demo data.
NOVA_POSHTA_API_KEY=
