:3000 {
	encode gzip

	# Proxy API + static media/uploads to the Node backend
	handle /api/* {
		reverse_proxy localhost:3001
	}

	handle /media/* {
		reverse_proxy localhost:3001
	}

	handle /uploads/* {
		reverse_proxy localhost:3001
	}

	# SPA: static files from Vite build, fallback to index.html
	handle {
		root * ./dist
		try_files {path} /index.html
		file_server
	}
}
